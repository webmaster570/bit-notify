rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper to check if user is admin
    function isAdmin() {
      return request.auth != null && (
        (request.auth.token.email != null && (request.auth.token.email.matches('(?i).*admin.*') || request.auth.token.email.matches('(?i).*webmaster.*'))) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    // Helper to check if user is push admin
    function isPushAdmin() {
      return request.auth != null && (
        (request.auth.token.email != null && (request.auth.token.email.matches('(?i).*admin.*') || request.auth.token.email.matches('(?i).*webmaster.*'))) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'push_admin' ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
        ))
      );
    }

    // Helper to check if user is faculty
    function isFaculty() {
      return request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'faculty';
    }

    match /users/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId || isAdmin() || isPushAdmin() || isFaculty());
      allow create: if request.auth != null && (request.auth.uid == userId || isAdmin());
      allow update: if request.auth != null && (request.auth.uid == userId || isAdmin());
      allow delete: if isAdmin();
    }

    match /notifications/{notificationId} {
      allow read: if request.auth != null;
      allow create, update: if isAdmin() || isPushAdmin() || isFaculty();
      allow delete: if isAdmin() || isPushAdmin();
    }

    match /fcmTokens/{tokenId} {
      allow read: if isAdmin() || isPushAdmin() || (request.auth != null && (request.auth.uid == tokenId || resource.data.uid == request.auth.uid));
      allow write: if request.auth != null && (request.auth.uid == tokenId || request.resource.data.uid == request.auth.uid);
      allow delete: if isAdmin() || (request.auth != null && (request.auth.uid == tokenId || resource.data.uid == request.auth.uid));
    }

    match /settings/{settingId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    match /system/config {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
