rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper to check if user is admin
    function isAdmin() {
      return request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Helper to check if user is faculty
    function isFaculty() {
      return request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'faculty';
    }

    match /users/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId || isAdmin() || isFaculty());
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && (request.auth.uid == userId || isAdmin());
    }

    match /notifications/{notificationId} {
      allow read: if request.auth != null;
      allow write: if isAdmin() || isFaculty();
    }

    match /fcmTokens/{tokenId} {
      allow read: if isAdmin() || (request.auth != null && (request.auth.uid == tokenId || resource.data.uid == request.auth.uid));
      allow write: if request.auth != null && (request.auth.uid == tokenId || request.resource.data.uid == request.auth.uid);
      allow delete: if request.auth != null && (request.auth.uid == tokenId || resource.data.uid == request.auth.uid);
    }

    match /settings/{settingId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }
  }
}
